<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_frame"
    android:padding="3dp">

    <!-- Full-Brightness Selected Background Image (widget1..widget6) -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- Very light bottom gradient (only 18% opacity) so image stays bright & text stays crisp -->
    <FrameLayout
        android:id="@+id/widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#26000000"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:gravity="space_between">

        <!-- TOP ROW: XP Pill (Left) + App Tag (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_xp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ 0 XP"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:background="@drawable/widget_xp_pill"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_bonus_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 +100 XP"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:background="@drawable/widget_yellow_pill"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />
        </LinearLayout>

        <!-- CENTER: Real Fire Emoji 🔥 + X Day Streak! -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/widget_fire_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥"
                android:textSize="38sp"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="4" />

            <TextView
                android:id="@+id/widget_streak_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 0 Day Streak!"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:shadowColor="#CCFFFFFF"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2" />
        </LinearLayout>

        <!-- BOTTOM: Daily 0/10 Flashcards + Green Progress Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/widget_daily_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📇 0 / 10 Daily Flashcards"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#111111" />

                <TextView
                    android:id="@+id/widget_subtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to study ▶"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#111111" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="10"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_draw" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
